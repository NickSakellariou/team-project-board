<Project Sdk="Aspire.AppHost.Sdk/13.0.2">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsAspireHost>true</IsAspireHost>
        <UserSecretsId>teamprojectboard-apphost</UserSecretsId>

        <!-- Why relaxed here: the AppHost is orchestration config, not application code.
             The Aspire SDK generates a Projects.* class per referenced project, and the
             generated code does not satisfy our documentation and analysis rules. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <AnalysisMode>Recommended</AnalysisMode>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TeamProjectBoard.Host\TeamProjectBoard.Host.csproj" />
    </ItemGroup>

</Project>
